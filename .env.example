# PostgreSQL (Railway provides this automatically when a Postgres service is linked)
DATABASE_URL=postgres://boyce:boyce@localhost:5432/boyce

# Where Meta performance data comes from (default: windsor = real data via Windsor.ai).
#   demo = synthetic numbers for LOCAL development only. Ignored in production
#          unless ALLOW_DEMO_DATA=true.
DATA_SOURCE=windsor

# Windsor.ai API key (onboard.windsor.ai -> API key). NOT a Meta token.
WINDSOR_API_KEY=
WINDSOR_MCP_URL=https://mcp.windsor.ai/

# First admin user, created by `npm run db:seed` if it does not exist yet.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Public read-only reporting: anyone with the link can view dashboards without
# signing in (editing always requires an admin/manager login). Set to "false"
# to require a login for viewing too.
PUBLIC_DASHBOARD=true
